# ==============================================================================
# Digital Twin Road — Environment Configuration Template (.env.example)
# Copy to .env to customize local or containerized execution:
#   cp .env.example .env
# ==============================================================================

# Data Curation Broker Backend
# Options: "native" (default: in-memory, zero dependencies), "fiware"
DATA_BROKER_BACKEND=native

# FIWARE Orion & IoT Agent UltraLight (when DATA_BROKER_BACKEND=fiware)
ORION_HOST=localhost
IOT_AGENT_HOST=localhost
IOT_AGENT_SOUTH_HOST=localhost

# FastAPI Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Endpoint Override (leave empty to use relative / origin proxy in Docker)
# VITE_API_URL=http://localhost:8000
